@page "/login"

@inject HelpDeskHero.UI.Services.Auth.AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<h3>Login</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <p style="color:red">
        @_error
    </p>
}

<EditForm Model="_model"
          OnValidSubmit="HandleLoginAsync">

    <DataAnnotationsValidator />

    <div>
        <label>Login</label>
    </div>

    <InputText
        @bind-Value="_model.UserName" />

    <br />
    <br />

    <div>
        <label>Hasło</label>
    </div>

    <InputText
        type="password"
        @bind-Value="_model.Password" />

    <br />
    <br />

    <button type="submit">
        Zaloguj
    </button>

</EditForm>

@code {

    private LoginVm _model =
        new();

    private string? _error;

    private async Task HandleLoginAsync()
    {
        var ok =
            await AuthService
                .LoginAsync(
                    _model.UserName,
                    _model.Password);

        if (!ok)
        {
            _error =
                "Błędny login lub hasło";

            return;
        }

        Nav.NavigateTo(
            "/tickets",
            true);
    }

    private sealed class LoginVm
    {
        public string UserName { get; set; }
            = "";

        public string Password { get; set; }
            = "";
    }
}