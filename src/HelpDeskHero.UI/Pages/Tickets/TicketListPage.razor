@page "/tickets"

@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Api

@inject TicketApiClient TicketApi

<h3>Tickets</h3>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">
        @_error
    </div>
}

@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert alert-success">
        @_success
    </div>
}

<select class="form-control mb-3"
        @bind="_statusFilter">

    <option>All</option>
    <option>New</option>
    <option>Closed</option>

</select>

<input class="form-control mb-2"
       placeholder="Title"
       @bind="_title" />

<textarea class="form-control mb-2"
          placeholder="Description"
          @bind="_description">
</textarea>

<select class="form-control mb-3"
        @bind="_priority">

    <option>Low</option>
    <option>Medium</option>
    <option>High</option>

</select>

<button class="btn btn-primary mb-4"
        @onclick="CreateTicket">

Dodaj Ticket

</button>

<table class="table">

<thead>
<tr>
<th>Number</th>
<th>Title</th>
<th>Status</th>
<th>Priority</th>
<th></th>
</tr>
</thead>

<tbody>

@foreach (var ticket in FilteredTickets)
{
<tr>

<td>@ticket.Number</td>

<td>

@if (_editId == ticket.Id)
{
<input class="form-control"
       @bind="_editTitle" />
}
else
{
@ticket.Title
}

</td>

<td>@ticket.Status</td>

<td>

@if (_editId == ticket.Id)
{
<select class="form-control"
        @bind="_editPriority">

<option>Low</option>
<option>Medium</option>
<option>High</option>

</select>
}
else
{
@ticket.Priority
}

</td>

<td>

@if (_editId == ticket.Id)
{
<button class="btn btn-primary me-2"
        @onclick="SaveEdit">

Zapisz

</button>

<button class="btn btn-secondary"
        @onclick="CancelEdit">

Anuluj

</button>
}
else
{
<button class="btn btn-warning me-2"
        @onclick="() => StartEdit(ticket)">

Edytuj

</button>

@if (ticket.Status != "Closed")
{
<button class="btn btn-success"
        @onclick="() => Close(ticket.Id)">

Zamknij

</button>
}
}

</td>

</tr>
}

</tbody>

</table>

@code {

List<TicketDto> _tickets = [];

string _title = "";
string _description = "";
string _priority = "Medium";

string _error = "";
string _success = "";

string _statusFilter = "All";

int? _editId;

string _editTitle = "";

string _editPriority = "";

IEnumerable<TicketDto> FilteredTickets =>
    _statusFilter == "All"
        ? _tickets
        : _tickets.Where(
            x => x.Status == _statusFilter);

protected override async Task OnInitializedAsync()
{
    await Load();
}

async Task Load()
{
    _tickets =
        (await TicketApi.GetAllAsync())
        .ToList();
}

async Task CreateTicket()
{
    _error = "";
    _success = "";

    if (string.IsNullOrWhiteSpace(_title))
    {
        _error = "Title jest wymagany";
        return;
    }

    if (string.IsNullOrWhiteSpace(_description))
    {
        _error = "Description jest wymagany";
        return;
    }

    await TicketApi.CreateAsync(
        new()
        {
            Title = _title,
            Description = _description,
            Priority = _priority
        });

    _title = "";
    _description = "";

    _success = "Ticket został dodany";

    await Load();
}

void StartEdit(
    TicketDto ticket)
{
    _editId =
        ticket.Id;

    _editTitle =
        ticket.Title;

    _editPriority =
        ticket.Priority;
}

void CancelEdit()
{
    _editId = null;
}

async Task SaveEdit()
{
    var ticket =
        _tickets
            .First(
                x => x.Id == _editId);

    await TicketApi.UpdateAsync(
        ticket.Id,
        new UpdateTicketDto
        {
            Title = _editTitle,
            Description = ticket.Description,
            Priority = _editPriority,
            Status = ticket.Status
        });

    _success =
        "Ticket zapisany";

    _editId =
        null;

    await Load();
}

async Task Close(
    int id)
{
    await TicketApi.CloseAsync(
        id);

    _success =
        "Ticket zamknięty";

    await Load();
}

}