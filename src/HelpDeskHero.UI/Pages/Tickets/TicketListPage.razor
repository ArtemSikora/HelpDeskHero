@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@page "/tickets"

@using HelpDeskHero.Shared.Contracts.Tickets
@using HelpDeskHero.UI.Services.Api
@using HelpDeskHero.UI.Services.Auth
@using Microsoft.JSInterop

@inject TicketApiClient TicketApi
@inject TokenStorageService TokenStorage
@inject IJSRuntime JS

<div class="d-flex align-items-center justify-content-between mb-3">
    <h3>Tickets</h3>

    <div>
        <button class="btn btn-outline-secondary me-2"
                @onclick="Load">
            Refresh
        </button>

        <button class="btn btn-outline-primary"
                @onclick="ExportCsv">
            Export CSV
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">
        @_error
    </div>
}

@if (!string.IsNullOrWhiteSpace(_success))
{
    <div class="alert alert-success">
        @_success
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <select class="form-control"
                @bind="_statusFilter">
            <option>All</option>
            <option>New</option>
            <option>Closed</option>
        </select>
    </div>

    @if (CanDelete)
    {
        <div class="col-md-4">
            <select class="form-control"
                    @bind="_deletedFilter"
                    @bind:after="Load">
                <option value="active">Active</option>
                <option value="deleted">Deleted</option>
                <option value="all">All</option>
            </select>
        </div>
    }
</div>

<div class="border rounded p-3 mb-4">
    <div class="row g-2">
        <div class="col-md-4">
            <input class="form-control"
                   placeholder="Title"
                   @bind="_title" />
        </div>

        <div class="col-md-5">
            <input class="form-control"
                   placeholder="Description"
                   @bind="_description" />
        </div>

        <div class="col-md-2">
            <select class="form-control"
                    @bind="_priority">
                <option>Low</option>
                <option>Medium</option>
                <option>High</option>
            </select>
        </div>

        <div class="col-md-1">
            <button class="btn btn-primary w-100"
                    @onclick="CreateTicket">
                Add
            </button>
        </div>
    </div>
</div>

<table class="table table-sm align-middle">
    <thead>
    <tr>
        <th>Number</th>
        <th>Title</th>
        <th>Status</th>
        <th>Priority</th>
        @if (CanDelete)
        {
            <th>Deleted</th>
        }
        <th></th>
    </tr>
    </thead>

    <tbody>
    @foreach (var ticket in FilteredTickets)
    {
        <tr class="@(ticket.IsDeleted ? "table-secondary" : "")">
            <td>@ticket.Number</td>

            <td>
                @if (_editId == ticket.Id)
                {
                    <input class="form-control"
                           @bind="_editTitle" />
                }
                else
                {
                    @ticket.Title
                }
            </td>

            <td>@ticket.Status</td>

            <td>
                @if (_editId == ticket.Id)
                {
                    <select class="form-control"
                            @bind="_editPriority">
                        <option>Low</option>
                        <option>Medium</option>
                        <option>High</option>
                    </select>
                }
                else
                {
                    @ticket.Priority
                }
            </td>

            @if (CanDelete)
            {
                <td>
                    @(ticket.IsDeleted ? ticket.DeletedAtUtc?.ToLocalTime().ToString("g") : "")
                </td>
            }

            <td class="text-end">
                @if (_editId == ticket.Id)
                {
                    <button class="btn btn-primary btn-sm me-2"
                            @onclick="SaveEdit">
                        Save
                    </button>

                    <button class="btn btn-secondary btn-sm"
                            @onclick="CancelEdit">
                        Cancel
                    </button>
                }
                else if (ticket.IsDeleted)
                {
                    @if (CanDelete)
                    {
                        <button class="btn btn-outline-success btn-sm"
                                @onclick="() => Restore(ticket.Id)">
                            Restore
                        </button>
                    }
                }
                else
                {
                    @if (CanEdit)
                    {
                        <button class="btn btn-warning btn-sm me-2"
                                @onclick="() => StartEdit(ticket)">
                            Edit
                        </button>
                    }

                    @if (CanClose && ticket.Status != "Closed")
                    {
                        <button class="btn btn-success btn-sm me-2"
                                @onclick="() => Close(ticket.Id)">
                            Close
                        </button>
                    }

                    @if (CanDelete)
                    {
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Delete(ticket.Id)">
                            Delete
                        </button>
                    }
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    private List<TicketDto> _tickets = [];

    private string _title = "";
    private string _description = "";
    private string _priority = "Medium";

    private string _error = "";
    private string _success = "";

    private string _statusFilter = "All";
    private string _deletedFilter = "active";

    private int? _editId;
    private string _editTitle = "";
    private string _editPriority = "";
    private string _editRowVersion = "";

    private string? _role;

    private bool CanEdit =>
        _role == "Admin"
        || _role == "Agent";

    private bool CanClose =>
        _role == "Admin"
        || _role == "Agent";

    private bool CanDelete =>
        _role == "Admin";

    private bool IncludeDeleted =>
        _deletedFilter == "all";

    private bool DeletedOnly =>
        _deletedFilter == "deleted";

    private IEnumerable<TicketDto> FilteredTickets =>
        _statusFilter == "All"
            ? _tickets
            : _tickets.Where(
                x => x.Status == _statusFilter);

    protected override async Task OnAfterRenderAsync(
        bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _role =
            await TokenStorage
                .GetRoleAsync();

        await Load();

        StateHasChanged();
    }

    private async Task Load()
    {
        try
        {
            _tickets =
                (await TicketApi.GetAllAsync(
                    IncludeDeleted,
                    DeletedOnly))
                .ToList();

            _error =
                "";
        }
        catch
        {
            _error =
                "Could not load tickets.";
        }
    }

    private async Task CreateTicket()
    {
        await TicketApi.CreateAsync(
            new()
            {
                Title = _title,
                Description = _description,
                Priority = _priority
            });

        _title = "";
        _description = "";

        await Load();
    }

    private void StartEdit(
        TicketDto ticket)
    {
        _editId = ticket.Id;
        _editTitle = ticket.Title;
        _editPriority = ticket.Priority;
        _editRowVersion = ticket.RowVersionBase64;
    }

    private void CancelEdit()
    {
        _editId = null;
        _editRowVersion = "";
    }

    private async Task SaveEdit()
    {
        var ticket =
            _tickets.First(
                x => x.Id == _editId);

        try
        {
            await TicketApi.UpdateAsync(
                ticket.Id,
                new UpdateTicketDto
                {
                    Title = _editTitle,
                    Description = ticket.Description,
                    Priority = _editPriority,
                    Status = ticket.Status,
                    RowVersionBase64 = _editRowVersion
                });

            _success = "Ticket saved.";
            _error = "";
        }
        catch
        {
            _error = "Ticket was changed by another user.";
            _success = "";
        }

        _editId = null;
        _editRowVersion = "";

        await Load();
    }

    private async Task Close(
        int id)
    {
        await TicketApi.CloseAsync(
            id);

        await Load();
    }

    private async Task Delete(
        int id)
    {
        await TicketApi.DeleteAsync(
            id);

        await Load();
    }

    private async Task Restore(
        int id)
    {
        await TicketApi.RestoreAsync(
            id);

        await Load();
    }

    private async Task ExportCsv()
    {
        var csv =
            await TicketApi.ExportCsvAsync(
                IncludeDeleted,
                DeletedOnly);

        await JS.InvokeVoidAsync(
            "authStorage.downloadTextFile",
            $"tickets-{DateTime.UtcNow:yyyyMMddHHmmss}.csv",
            "text/csv",
            csv);
    }
}
